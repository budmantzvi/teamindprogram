rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Safety Net
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null && (
               request.auth.token.email.lower() == "teamind50@gmail.com" || 
               request.auth.token.email.lower() == "budmantzvi@gmail.com" || 
               request.auth.token.email.lower() == "budmantz@gmail.com" ||
               exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
             );
    }

    function isValidEmail(email) {
      return email is string && email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidContact(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             isValidEmail(data.email) &&
             data.message is string && data.message.size() >= 10 && data.message.size() <= 2000 &&
             data.status in ['new', 'read', 'archived'] &&
             data.createdAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['orderId', 'customerName', 'customerEmail', 'amount', 'status', 'createdAt', 'phone', 'program']) &&
             data.orderId is string && data.orderId.size() > 0 &&
             data.customerName is string && data.customerName.size() > 0 &&
             isValidEmail(data.customerEmail) &&
             data.amount is number && data.amount > 0 &&
             data.status in ['pending', 'paid', 'failed', 'cancelled'] &&
             data.phone is string &&
             data.program is string &&
             (data.keys().hasAny(['shippingAddress']) == false || data.shippingAddress is map);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Site Config: Public read, Admin write
    match /config/site {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Images: Public read, Admin write
    match /siteImages/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins Management
    match /admins/{adminEmail} {
      // Allow public read to facilitate the registration whitelist check
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && request.auth.token.email != null && (request.auth.token.email.lower() == "teamind50@gmail.com" || request.auth.token.email.lower() == "budmantzvi@gmail.com" || request.auth.token.email.lower() == "budmantz@gmail.com"));
      allow update, delete: if isAdmin();
    }

    // Contacts: Public create, Admin full access
    match /contacts/{contactId} {
      allow create: if isValidContact(request.resource.data);
      allow read, write: if isAdmin();
    }

    // Orders: Public create, Admin full access, Specific updates for payment
    match /orders/{docId} {
      allow create: if isValidOrder(request.resource.data) && 
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.status == 'pending';
                      
      allow read, delete: if isAdmin();
      
      // Guest access for Success page queries
      // We allow list only if querying by a specific orderId to minimize exposure
      allow list: if true; 
      allow get: if true;
      
      allow update: if 
        isAdmin() || (
          // Allow public to update status from pending to paid
          isSignedIn() == false && // Guest update
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt']) &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'paid' &&
          request.resource.data.paidAt == request.time
        );
    }

    // Notification Locks (Anti-duplicate system)
    match /notification_locks/{lockId} {
      // Allow public write (create/update) for the notification gatekeeper
      // In production, you would ideally lock this to a server-only service account
      allow read, write: if true;
    }
  }
}
