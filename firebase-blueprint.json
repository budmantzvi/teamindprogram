{
  "entities": {
    "siteConfig": {
      "title": "Site Configuration",
      "description": "Global website settings and content",
      "type": "object",
      "properties": {
        "contactEmail": { "type": "string", "format": "email" },
        "contactPhone": { "type": "string" },
        "titles": {
          "type": "object",
          "properties": {
            "heroTitle": { "type": "string" },
            "heroSubtitle": { "type": "string" },
            "aboutTitle": { "type": "string" },
            "programsTitle": { "type": "string" },
            "kitTitle": { "type": "string" },
            "pricingTitle": { "type": "string" }
          }
        }
      }
    },
    "contact": {
      "title": "Contact Submission",
      "description": "Messages from the contact form",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
    "order": {
      "title": "Order",
      "description": "Payment records from Meshulam",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "program": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "description": "Firestore Server Timestamp" },
        "paidAt": { "type": "string", "description": "Firestore Server Timestamp" }
      },
      "required": ["customerName", "customerEmail", "amount", "status", "createdAt"]
    }
  },
  "firestore": {
    "/config/site": {
      "schema": "siteConfig",
      "description": "Global site content and settings"
    },
    "/contacts/{contactId}": {
      "schema": "contact",
      "description": "User contact submissions"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Payment and order records"
    },
    "/admins/{email}": {
      "schema": {
        "title": "Admin",
        "description": "Authorized administrator",
        "type": "object",
        "properties": {
          "addedBy": { "type": "string" },
          "addedAt": { "type": "string", "format": "date-time" }
        }
      },
      "description": "List of authorized administrator emails"
    },
    "/users/{userId}": {
      "schema": {
        "title": "User",
        "description": "User profile with role information",
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "is_admin": { "type": "boolean" },
          "role": { "type": "string" }
        }
      },
      "description": "User profiles for role-based access"
    }
  }
}
